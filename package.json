{
  "name": "jobber-automation-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check": "npm run build && npm test",
    "installer:dev": "node installer/launcher.cjs --config installer/launcher-config.json --ui installer/ui.html --payload .",
    "smoke": "./scripts/smoke-test.sh",
    "test": "vitest run && node --test installer/lib.node-test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
