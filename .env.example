PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
MCP_PATH_TOKEN=generate-a-long-random-value
SETUP_KEY=generate-a-different-long-random-value
JOBBER_CLIENT_ID=your-jobber-client-id
JOBBER_CLIENT_SECRET=enter-locally-never-in-chat-or-git
JOBBER_GRAPHQL_VERSION=2025-04-16
DATABASE_PATH=./data/jobber-mcp.sqlite
AUTOMATION_POLL_SECONDS=30
ENABLE_AUTOMATION_WORKER=true

# OpenAI Secure MCP Tunnel. Keep the runtime-key file outside this repository.
OPENAI_TUNNEL_ID=tunnel_replace_with_your_tunnel_id
TUNNEL_KEY_FILE=/home/your-user/.config/tunnel-client/secrets/jobber-mcp-runtime-key
